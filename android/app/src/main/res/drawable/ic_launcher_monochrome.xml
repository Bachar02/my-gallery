<?xml version="1.0" encoding="utf-8"?>
<!-- Themed (monochrome) icon for Android 13+: the launcher uses only the alpha
     channel, so the photo is drawn as line art to keep the landscape and lens
     readable. Same geometry and transform as ic_launcher_foreground.xml. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:translateX="-2"
        android:translateY="-2">
        <!-- Photo frame, open where the magnifier overlaps it -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M57,71 H34 A7,7 0 0 1 27,64 V38 A7,7 0 0 1 34,31 H68 A7,7 0 0 1 75,38 V56" />
        <!-- Landscape and sun -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M33,65 L44,51 L51,58 L55,53 L57,65 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M63,36 A4,4 0 1 1 62.99,36 Z" />
        <!-- Magnifier -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4.5"
            android:pathData="M69,60 A9,9 0 1 1 68.99,60 Z" />
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="6.5"
            android:strokeLineCap="round"
            android:pathData="M76,76 L85,85" />
    </group>
</vector>