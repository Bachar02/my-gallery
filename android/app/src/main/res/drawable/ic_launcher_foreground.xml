<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon foreground: a photo with a magnifier. Same geometry as
     tool/branding/make_icon.py (108x108 adaptive-icon space). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Scaled about the centre and shifted up-left so the magnifier handle
         stays inside the circular safe zone (radius 33). -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:translateX="-2"
        android:translateY="-2">
    <!-- Photo card -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M34,31 H68 A7,7 0 0 1 75,38 V64 A7,7 0 0 1 68,71 H34 A7,7 0 0 1 27,64 V38 A7,7 0 0 1 34,31 Z" />
    <!-- Landscape -->
    <path
        android:fillColor="#8FD3CF"
        android:pathData="M31,67 L44,50 L52,58 L60,47 L71,67 Z" />
    <path
        android:fillColor="#F2B66D"
        android:pathData="M63,36 A4,4 0 1 1 62.99,36 Z" />
    <!-- Magnifier handle -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:pathData="M76,76 L85,85" />
    <!-- Magnifier ring and lens -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M69,58 A11,11 0 1 1 68.99,58 Z" />
    <path
        android:fillColor="#104D54"
        android:pathData="M69,62.5 A6.5,6.5 0 1 1 68.99,62.5 Z" />
    </group>
</vector>
